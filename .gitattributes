# 换行符与二进制处理
# ---------------------------------------------------------------
# 为什么需要它：这个项目在 Windows 上开发，但 gradlew / 脚本必须是 LF，
# 否则拿到别的机器（或 Git Bash）上会报 "bad interpreter"。
# 图片、jar 这类必须是二进制，绝不能被当成文本改行尾。

* text=auto

# 必须是 LF 的脚本（Git Bash / macOS / Linux 都要能跑）
gradlew        text eol=lf
*.sh           text eol=lf

# 源码与文本：统一 LF，避免整文件被"改行尾"式的假 diff
*.java         text eol=lf
*.py           text eol=lf
*.json         text eol=lf
*.md           text eol=lf
*.gradle       text eol=lf
*.properties   text eol=lf
*.toml         text eol=lf
*.html         text eol=lf
*.css          text eol=lf
*.xml          text eol=lf
*.mcmeta       text eol=lf

# Windows 专用批处理：必须 CRLF
*.bat          text eol=crlf
*.cmd          text eol=crlf

# 二进制：不要动
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
*.jar          binary
*.zip          binary
*.nbt          binary
*.ogg          binary
*.bbmodel      binary

# 让 git 在 diff / status 里正常显示中文文件名
# （这是仓库级设置，写在这里只是提醒；实际用 core.quotepath=false）
